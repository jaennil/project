{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "bbtop_cpu_usage_percent{instance=\"$host\"}", "legendFormat": "CPU", "refId": "A"}],
      "title": "CPU usage",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "100 * (1 - bbtop_memory_available_bytes{instance=\"$host\"} / bbtop_memory_total_bytes{instance=\"$host\"})", "legendFormat": "Memory", "refId": "A"}],
      "title": "Memory usage",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "bbtop_processes{instance=\"$host\"}", "legendFormat": "all", "refId": "A"}, {"expr": "bbtop_processes_running{instance=\"$host\"}", "legendFormat": "running", "refId": "B"}],
      "title": "Processes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "bbtop_uptime_seconds{instance=\"$host\"}", "legendFormat": "uptime", "refId": "A"}],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_cpu_usage_percent{instance=\"$host\"}", "legendFormat": "CPU", "refId": "A"}],
      "title": "CPU history",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_memory_total_bytes{instance=\"$host\"} - bbtop_memory_available_bytes{instance=\"$host\"}", "legendFormat": "used", "refId": "A"}, {"expr": "bbtop_memory_available_bytes{instance=\"$host\"}", "legendFormat": "available", "refId": "B"}],
      "title": "Memory history",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Uplink throughput, summed over physical interfaces only. Bridges, veth pairs and loopback carry copies of traffic their uplink counts again, so including them would multiply it. Rates are computed per interface and summed afterwards, which keeps one interface disappearing from looking like a burst.",
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "sum(rate(bbtop_network_receive_bytes_total{kind=\"physical\",instance=\"$host\"}[$__rate_interval]))", "legendFormat": "receive", "refId": "A"}, {"expr": "sum(rate(bbtop_network_transmit_bytes_total{kind=\"physical\",instance=\"$host\"}[$__rate_interval]))", "legendFormat": "transmit", "refId": "B"}],
      "title": "Network throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 3500000000, "min": 0, "unit": "Bps", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 2450000000}, {"color": "red", "value": 3150000000}]}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "rate(bbtop_disk_read_bytes_total{instance=\"$host\"}[$__rate_interval])", "legendFormat": "read", "refId": "A"}, {"expr": "rate(bbtop_disk_write_bytes_total{instance=\"$host\"}[$__rate_interval])", "legendFormat": "write", "refId": "B"}],
      "description": "Current PCIe 3.0 x4 link ceiling is approximately 3.5 GB/s. Thresholds: 70% and 90%.",
      "title": "Disk throughput · max ≈ 3.5 GB/s",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 21},
      "id": 9,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, bbtop_process_cpu_usage_percent{instance=\"$host\"})", "legendFormat": "{{name}} ({{pid}})", "refId": "A"}],
      "title": "Top process CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 21},
      "id": 10,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, bbtop_process_resident_memory_bytes{instance=\"$host\"})", "legendFormat": "{{name}} ({{pid}})", "refId": "A"}],
      "title": "Top process memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Used space as a percentage of capacity for each real host filesystem.",
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
      "id": 12,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "100 * bbtop_filesystem_used_bytes{instance=\"$host\"} / bbtop_filesystem_size_bytes{instance=\"$host\"}", "legendFormat": "{{mountpoint}} · {{device}}", "refId": "A"}],
      "title": "Filesystem usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "RPM reported by Linux hwmon. No data means the firmware or kernel driver does not expose a fan sensor.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "rpm"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
      "id": 11,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_fan_speed_rpm{instance=\"$host\"}", "legendFormat": "{{chip}} · {{sensor}}", "refId": "A"}],
      "title": "Fan speed",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "All temperatures exposed by Linux hwmon. Sensor names come from the kernel driver labels when available.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "celsius"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38},
      "id": 13,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_temperature_celsius{instance=\"$host\"}", "legendFormat": "{{chip}} · {{sensor}}", "refId": "A"}],
      "title": "Hardware temperatures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Component power from Linux hwmon: these series cover parts such as the SoC package, not the whole machine. The battery series is charging power while plugged in, and while discharging it equals total laptop draw - the only state where total draw is measurable, because the charger exposes no telemetry.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "watt"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 46},
      "id": 14,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_power_watts{instance=\"$host\"}", "legendFormat": "{{chip}} · {{sensor}} · {{reading}}", "refId": "A"}, {"expr": "bbtop_battery_power_watts{instance=\"$host\"}", "legendFormat": "battery · {{status}}", "refId": "B"}],
      "title": "Hardware power",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 54},
      "id": 16,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_battery_charge_percent{instance=\"$host\"}", "legendFormat": "{{battery}} · {{status}}", "refId": "A"}],
      "title": "Battery charge",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "volt"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
      "id": 17,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_voltage_volts{instance=\"$host\"}", "legendFormat": "{{chip}} · {{sensor}}", "refId": "A"}],
      "title": "Hardware voltages",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "amp"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 62},
      "id": 18,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_current_amperes{instance=\"$host\"}", "legendFormat": "{{chip}} · {{sensor}}", "refId": "A"}],
      "title": "Hardware currents",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Hardware temperature limits. Invalid firmware sentinel values are excluded.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "celsius"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 70},
      "id": 19,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_temperature_limit_celsius{instance=\"$host\"}", "legendFormat": "{{chip}} · {{sensor}} · {{limit}}", "refId": "A"}],
      "title": "Temperature safety limits",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "hertz"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 70},
      "id": 20,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_cpu_frequency_hertz{instance=\"$host\"}", "legendFormat": "CPU {{cpu}}", "refId": "A"}],
      "title": "CPU frequency per core",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Charger connection state over time. On means the mains supply is online; the gaps are the intervals the laptop spent on battery, when total power draw is measurable.",
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "unit": "bool_on_off", "custom": {"lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 25, "showPoints": "never", "spanNulls": true}}},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 78},
      "id": 21,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}},
      "targets": [{"expr": "bbtop_mains_online{instance=\"$host\"}", "legendFormat": "{{supply}}", "refId": "A"}],
      "title": "External power connected",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 83},
      "id": 22,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_nvme_percentage_used{instance=\"$host\"}", "legendFormat": "{{device}} · used", "refId": "A"}, {"expr": "bbtop_nvme_available_spare_percent{instance=\"$host\"}", "legendFormat": "{{device}} · spare", "refId": "B"}],
      "title": "NVMe health",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 83},
      "id": 23,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_nvme_media_errors_total{instance=\"$host\"}", "legendFormat": "{{device}} · media errors", "refId": "A"}, {"expr": "bbtop_nvme_error_log_entries_total{instance=\"$host\"}", "legendFormat": "{{device}} · error log", "refId": "B"}, {"expr": "bbtop_nvme_unsafe_shutdowns_total{instance=\"$host\"}", "legendFormat": "{{device}} · unsafe shutdowns", "refId": "C"}],
      "title": "NVMe errors and unsafe shutdowns",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-process disk reads and writes. This measures I/O throughput, not filesystem space owned by a process.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "Bps"}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 91},
      "id": 24,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, rate(bbtop_process_read_bytes_total{instance=\"$host\"}[$__rate_interval]))", "legendFormat": "read · {{name}} ({{pid}})", "refId": "A"}, {"expr": "topk(10, rate(bbtop_process_write_bytes_total{instance=\"$host\"}[$__rate_interval]))", "legendFormat": "write · {{name}} ({{pid}})", "refId": "B"}],
      "title": "Top process disk I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-process network throughput traced at the socket layer by the bbtop-net eBPF collector. Payload bytes only: protocol headers, retransmits and kernel traffic are excluded, so these series stay below the interface counters.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "Bps"}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 100},
      "id": 25,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, rate(bbtop_process_network_receive_bytes_total{instance=\"$host\"}[$__rate_interval]))", "legendFormat": "rx · {{name}} ({{pid}})", "refId": "A"}, {"expr": "topk(10, rate(bbtop_process_network_transmit_bytes_total{instance=\"$host\"}[$__rate_interval]))", "legendFormat": "tx · {{name}} ({{pid}})", "refId": "B"}],
      "title": "Top process network I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Share of time the GPU had work in flight, as the DRM driver reports it. Cards whose driver omits this counter, such as Intel integrated graphics, do not appear.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "percent", "max": 100}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 109},
      "id": 26,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_gpu_busy_percent{instance=\"$host\"}", "legendFormat": "{{driver}} · {{card}}", "refId": "A"}],
      "title": "GPU load",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "VRAM in use against the total the card exposes.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 109},
      "id": 27,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "bbtop_gpu_vram_used_bytes{instance=\"$host\"}", "legendFormat": "used · {{driver}}", "refId": "A"}, {"expr": "bbtop_gpu_vram_total_bytes{instance=\"$host\"}", "legendFormat": "total · {{driver}}", "refId": "B"}],
      "title": "GPU memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-process GPU time from the DRM fdinfo interface. Engines run in parallel, so the sum of their busy time can pass 100% the same way process CPU does across cores.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "percent"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 117},
      "id": 28,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, bbtop_process_gpu_percent{instance=\"$host\"})", "legendFormat": "{{name}} ({{pid}})", "refId": "A"}],
      "title": "Top process GPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "VRAM charged to each process. Memory stays counted while a process holds it, whether or not any work is running.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 117},
      "id": 29,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, bbtop_process_gpu_vram_bytes{instance=\"$host\"})", "legendFormat": "{{name}} ({{pid}})", "refId": "A"}],
      "title": "Top process VRAM",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "How fast the battery is filling or draining, as the slope of its state of charge. Positive is charging. The pace is set by the laptop's own charge controller, so a bigger charger does not move it.",
      "fieldConfig": {"defaults": {"unit": "suffix: %/h", "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 54},
      "id": 30,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "deriv(bbtop_battery_charge_percent{instance=\"$host\"}[10m]) * 3600", "legendFormat": "{{battery}} · {{status}}", "refId": "A"}],
      "title": "Battery charge rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-tab figures come from the browser itself through the bbtop-tabs collector, because a content process carries no origin the kernel could report. The site is shown next to the title because page titles alone are often useless. With Fission one process can host several documents of one site, and then they share a single number - bbtop_browser_tab_documents says how many.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "percent"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 126},
      "id": 31,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, bbtop_browser_tab_cpu_percent{instance=\"$host\"})", "legendFormat": "{{title}} · {{site}}", "refId": "A"}],
      "title": "Top browser tabs · CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-tab figures come from the browser itself through the bbtop-tabs collector, because a content process carries no origin the kernel could report. The site is shown next to the title because page titles alone are often useless. With Fission one process can host several documents of one site, and then they share a single number - bbtop_browser_tab_documents says how many.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 126},
      "id": 32,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
      "targets": [{"expr": "topk(10, bbtop_browser_tab_memory_bytes{instance=\"$host\"})", "legendFormat": "{{title}} · {{site}}", "refId": "A"}],
      "title": "Top browser tabs · memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Package power split across processes by the CPU time each one used. Sensors measure hardware, never tasks, so this is an attribution, not a measurement: it covers the CPU and GPU package only, while the display, disk and radios drain the same battery and belong to no process. The figures sum to less than the package because processes outside the exported ranking and kernel work are not shown.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "watt"}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 135},
      "id": 33,
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max", "mean", "median"]}},
