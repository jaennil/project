#!/bin/sh
set -eu

PATH=/usr/bin:/bin
umask 022

program=/usr/local/libexec/bbtop-net.bt
snapshot=/run/bbtop/process-net.txt

# bpftrace accumulates per-PID byte counters in kernel maps and dumps both maps
# every interval. awk turns each dump into a snapshot published by rename, so
# the unprivileged exporter never reads a half-written table.
bpftrace -q "$program" | awk -v snapshot="$snapshot" '
function publish(   key, temporary) {
    temporary = snapshot ".new"
    printf "# pid receive_bytes transmit_bytes\n" >temporary
    for (key in seen)
        printf "%s %d %d\n", key, receive[key], transmit[key] >temporary
    close(temporary)
    system("mv -f " temporary " " snapshot)
    delete receive
    delete transmit
    delete seen
}

$1 ~ /^@rx\[[0-9]+\]:$/ {
    pid = substr($1, 5, length($1) - 6)
    receive[pid] = $2
    seen[pid] = 1
    next
}

$1 ~ /^@tx\[[0-9]+\]:$/ {
    pid = substr($1, 5, length($1) - 6)
    transmit[pid] = $2
    seen[pid] = 1
    next
}

/^snapshot-end$/ {
    publish()
}
'
