      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * (agent_rate_limit_used_ratio{provider=\"claude_code\",window=\"5h\"} and on (provider, limit, bucket, window) (agent_rate_limit_reset_timestamp_seconds > time()))",
          "legendFormat": "Claude Code usage",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "100 * (agent_rate_limit_linear_budget_ratio{provider=\"claude_code\",window=\"5h\"} and on (provider, limit, bucket, window) (agent_rate_limit_reset_timestamp_seconds > time()))",
          "legendFormat": "alert boundary",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "vector(95) and on () count(agent_rate_limit_reset_timestamp_seconds{provider=\"claude_code\",window=\"5h\"} > time())",
          "legendFormat": "critical 95%",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Claude Code · 5-hour window",
      "type": "timeseries",
      "timeFrom": "6h"
    },
